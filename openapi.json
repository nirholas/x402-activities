{
  "openapi": "3.1.0",
  "info": {
    "title": "x402-activities",
    "version": "0.1.0",
    "description": "Tours and activities search via Amadeus — agents find bookable experiences by location. Paid routes use the x402 protocol (HTTP 402, USDC on Base).",
    "license": { "name": "Apache-2.0", "identifier": "Apache-2.0" }
  },
  "servers": [{ "url": "http://localhost:4021" }],
  "paths": {
    "/": {
      "get": {
        "operationId": "getServiceInfo",
        "summary": "Service metadata (free)",
        "responses": {
          "200": {
            "description": "Service info with routes and payment details",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness probe (free)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "uptime": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/x402": {
      "get": {
        "operationId": "getX402Manifest",
        "summary": "x402 discovery manifest (free)",
        "responses": {
          "200": {
            "description": "Machine-readable list of paid resources",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "searchActivities",
        "summary": "Search tours & activities around a coordinate ($0.003 via x402)",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": -90, "maximum": 90 },
            "description": "Latitude"
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": -180, "maximum": 180 },
            "description": "Longitude"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20,
              "default": 1
            },
            "description": "Search radius in km"
          }
        ],
        "responses": {
          "200": {
            "description": "Activities near the coordinate (the purchased artifact)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResult" }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "402": {
            "description": "Payment required — pay via x402 and retry with X-PAYMENT header",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentRequirements" }
              }
            }
          },
          "502": {
            "description": "Upstream (Amadeus) error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["error", "message"]
      },
      "PaymentRequirements": {
        "type": "object",
        "description": "x402 payment requirements returned with HTTP 402",
        "properties": {
          "x402Version": { "type": "integer" },
          "error": { "type": "string" },
          "accepts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheme": { "type": "string", "example": "exact" },
                "network": { "type": "string", "example": "base-sepolia" },
                "maxAmountRequired": { "type": "string" },
                "resource": { "type": "string" },
                "description": { "type": "string" },
                "mimeType": { "type": "string" },
                "payTo": { "type": "string" },
                "maxTimeoutSeconds": { "type": "integer" },
                "asset": { "type": "string" },
                "extra": { "type": "object" }
              }
            }
          }
        }
      },
      "Activity": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "shortDescription": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "price": {
            "type": ["object", "null"],
            "properties": {
              "amount": { "type": "string" },
              "currencyCode": { "type": "string" }
            }
          },
          "rating": { "type": ["number", "null"] },
          "pictures": { "type": "array", "items": { "type": "string" } },
          "bookingLink": { "type": ["string", "null"] },
          "minimumDuration": { "type": ["string", "null"] }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "source": { "type": "string", "enum": ["amadeus", "fixture"] },
          "query": {
            "type": "object",
            "properties": {
              "latitude": { "type": "number" },
              "longitude": { "type": "number" },
              "radiusKm": { "type": "number" }
            }
          },
          "count": { "type": "integer" },
          "activities": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Activity" }
          },
          "retrievedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
