# ─── Required ────────────────────────────────────────────────────────────────
# EVM address that receives USDC payments for paid routes. The server refuses
# to boot without it.
PAY_TO_ADDRESS=0xYourAddressHere

# ─── Payment network (defaults shown) ────────────────────────────────────────
# base-sepolia (testnet, default) or base (mainnet).
#NETWORK=base-sepolia
# Facilitator that verifies + settles payments. The default x402.org
# facilitator supports base-sepolia only; use a mainnet-capable facilitator
# (e.g. Coinbase CDP) together with NETWORK=base.
#FACILITATOR_URL=https://x402.org/facilitator

# ─── Server ──────────────────────────────────────────────────────────────────
#PORT=4021

# ─── Amadeus (optional — live tours & activities data) ───────────────────────
# Free self-service keys: https://developers.amadeus.com
# When unset, /search serves deterministic fixtures labeled source:"fixture".
#AMADEUS_CLIENT_ID=
#AMADEUS_CLIENT_SECRET=
# Amadeus environment base URL. Default is the free test environment.
#AMADEUS_BASE_URL=https://test.api.amadeus.com

# ─── Example client (examples/agent-client.ts) ───────────────────────────────
# Private key of a wallet holding base-sepolia USDC (https://faucet.circle.com).
#PRIVATE_KEY=
#BASE_URL=http://localhost:4021
